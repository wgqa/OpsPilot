dd7e6", "created_at": "2026-11-05T07:56:27.952+00:00"}, {"observation_id": "observation-da47363c-866a-4faa-ae9e-a7a82ab07674", "task_id": "task-370fba68-b1ad-416d-9319-a19c38e6fb6c", "call_id": "call-1d55325b-a6cb-4660-9a6f-fc1c7fc25dab", "attempt_id": "attempt-60c03150-34a7-4561-bcde-692698efa557", "tool_call_id": "tool-6", "tool_name": "search_callback_knowledge", "argument_digest": "b925976f8bf9e2ce967453e53e4763557f524cc2b083b51d38d218b30899b5e9", "status": "OK", "progress_added": 1, "error_class": null, "result_digest": "3fde13db9394b11a81fa49316eef4a58d37ed3be284c13a09207fbd93622f265", "result_json": "{\"contract_version\":2,\"documents\":[{\"active\":true,\"applicable\":\"true\",\"bound_contract_version\":2,\"content\":\"# Receiver acknowledgement and processing SLA v2.1\\n\\nAn HTTP 202 from the receiver proves durable acceptance into its queue only. It does not by itself prove that the receiver completed business processing.\\n\\nCheck the receiver's current state for the same `event_id` and `delivery_version`. `PROCESSED` is sufficient to prove completion even before the SLA deadline, provided the current receiver observation is correlated to that same event and delivery version.\\n\\nSLA only sets the handling direction for a same-event receiver that remains `QUEUED`: before the trusted deadline, continue observing; at or after the deadline, contact the receiver operator to investigate. An overdue `QUEUED` state does not by itself prove business failure or event loss.\\n\\nHTTP 202 alone proves acceptance only; without current same-event receiver evidence, the processing state is `UNKNOWN`. Do not infer the target event's state from elapsed time, a different event, an order snapshot, or historical advice. Never resend automatically.\\n\",\"contract_versions\":[2],\"digest\":\"5fb3732339600ad1332960df08a00299358b8c4ea47c20f6fedc39b568c9850e\",\"document_id\":\"receiver-ack-contract-v2\",\"expires_at\":\"2030-01-01T00:00:00+00:00\",\"file\":\"receiver-ack-contract-v2-1.md\",\"keywords\":[\"202\",\"receiver\",\"queue\",\"accepted\",\"processed\",\"processing_sla_seconds\",\"����\",\"�Ŷ�\",\"SLA\"],\"matched_terms\":[\"202\",\"acknowledgement\",\"http\",\"receiver\"],\"query\":\"HTTP 202 receiver acknowledgement\",\"retrieval_method\":\"bm25-lite-v1\",\"retrieval_score\":5.661359848075995,\"source\":\"local:orders-async-demo/contract-v2.1\",\"title\":\"Receiver acknowledgement and processing SLA v2\",\"valid_from\":\"2026-10-25T00:00:00+00:00\",\"version\":\"2.1.0\"}],\"ranking_method\":\"bm25-lite-v1\",\"reason\":\"read an applicable source missing from this Run; deterministic test double\"}", "evidence_id": null, "created_at": "2026-11-05T07:56:28.082+00:00"}, {"observation_id": "observation-93d25bbf-5c38-4d05-b182-fd9a64565f39", "task_id": "task-370fba68-b1ad-416d-9319-a19c38e6fb6c", "call_id": "call-021f9864-9b76-45ea-bae6-dac5154457af", "attempt_id": "attempt-2969f02e-3ef7-454e-b8d1-d37a83f54374", "tool_call_id": "tool-9", "tool_name": "get_receiver_processing", "argument_digest": "32a18bb796fc071a85e1c4c9323ba9bf3536e2c0d4388be8aecf6145ad93692d", "status": "OK", "progress_added": 1, "error_class": null, "result_digest": "216bb451ba68305102ad51856f085a5101e9c3cc254b70dc864c2e6c30e4443a", "result_json": "{\"data_source\":\"sqlite:s3_receivers\",\"fact_type\":\"s3_receiver\",\"facts\":{\"accepted_at\":\"2026-11-05T07:56:23.108093Z\",\"delivery_version\":2,\"event_id\":\"event-4476023a-10f4-4d34-98fd-793ef71a9abd\",\"order_id\":\"async-order\",\"processing_sla_seconds\":300,\"service_id\":\"orders-async-demo\",\"status\":\"PROCESSED\",\"tenant_id\":\"tenant-a\",\"version\":3},\"observed_at\":\"2026-11-05T07:56:29.557+00:00\",\"observed_versions\":{\"config_version\":1,\"contract_version\":2,\"delivery_version\":2,\"grant_version\":1,\"order_version\":2,\"policy_version\":1,\"principal_version\":1,\"receiver_version\":3,\"scope_policy_version\":1},\"original_result_ref\":\"s3://event-4476023a-10f4-4d34-98fd-793ef71a9ab