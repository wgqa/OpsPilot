nce-dc8c9e30-dcc2-48dd-af30-1a11da7be24d", "created_at": "2026-11-05T07:56:20.360+00:00"}, {"observation_id": "observation-4eccaaf5-7752-4d3d-8d01-b7e2b9f13bbd", "task_id": "task-49e3653e-744f-4e08-932e-1e017612c8f1", "call_id": "call-90f70761-1afd-448b-8b58-a642f28e2fd5", "attempt_id": "attempt-caa14fbb-4869-4f5e-bff4-dd242061f6d0", "tool_call_id": "tool-3", "tool_name": "get_receiver_processing", "argument_digest": "32a18bb796fc071a85e1c4c9323ba9bf3536e2c0d4388be8aecf6145ad93692d", "status": "OK", "progress_added": 1, "error_class": null, "result_digest": "3e49bf6033cacf050f76f495dd1073ea4953aaaa244241adeed5158251f7acc2", "result_json": "{\"data_source\":\"sqlite:s3_receivers\",\"fact_type\":\"s3_receiver\",\"facts\":{\"accepted_at\":\"2026-11-05T07:56:16.923193Z\",\"delivery_version\":2,\"event_id\":\"event-8b1ce475-b385-4045-b89a-f81d289b230b\",\"order_id\":\"async-order\",\"processing_sla_seconds\":300,\"service_id\":\"orders-async-demo\",\"status\":\"QUEUED\",\"tenant_id\":\"tenant-a\",\"version\":2},\"observed_at\":\"2026-11-05T07:56:20.507+00:00\",\"observed_versions\":{\"config_version\":1,\"contract_version\":2,\"delivery_version\":2,\"grant_version\":1,\"order_version\":2,\"policy_version\":1,\"principal_version\":1,\"receiver_version\":2,\"scope_policy_version\":1},\"original_result_ref\":\"s3://event-8b1ce475-b385-4045-b89a-f81d289b230b/v2\",\"principal_id\":\"async-principal-a\",\"resource_id\":\"orders-async-demo:async-order\",\"task_id\":\"task-49e3653e-744f-4e08-932e-1e017612c8f1\",\"tenant_id\":\"tenant-a\",\"trust_class\":\"untrusted_tool_observation\"}", "evidence_id": "evidence-6b50a797-311d-494b-8df1-41a1182b7b25", "created_at": "2026-11-05T07:56:20.511+00:00"}, {"observation_id": "observation-36f29c12-f74f-44b4-918b-e64be06740a8", "task_id": "task-49e3653e-744f-4e08-932e-1e017612c8f1", "call_id": "call-ef6a95a0-21a6-4cea-b8a6-b3ca47047500", "attempt_id": "attempt-d40114bc-d4e5-475a-af1d-70096e44cdbf", "tool_call_id": "tool-5", "tool_name": "search_callback_knowledge", "argument_digest": "b925976f8bf9e2ce967453e53e4763557f524cc2b083b51d38d218b30899b5e9", "status": "OK", "progress_added": 1, "error_class": null, "result_digest": "3fde13db9394b11a81fa49316eef4a58d37ed3be284c13a09207fbd93622f265", "result_json": "{\"contract_version\":2,\"documents\":[{\"active\":true,\"applicable\":\"true\",\"bound_contract_version\":2,\"content\":\"# Receiver acknowledgement and processing SLA v2.1\\n\\nAn HTTP 202 from the receiver proves durable acceptance into its queue only. It does not by itself prove that the receiver completed business processing.\\n\\nCheck the receiver's current state for the same `event_id` and `delivery_version`. `PROCESSED` is sufficient to prove completion even before the SLA deadline, provided the current receiver observation is correlated to that same event and delivery version.\\n\\nSLA only sets the handling direction for a same-event receiver that remains `QUEUED`: before the trusted deadline, continue observing; at or after the deadline, contact the receiver operator to investigate. An overdue `QUEUED` state does not by itself prove business failure or event loss.\\n\\nHTTP 202 alone proves acceptance only; without current same-event receiver evidence, the processing state is `UNKNOWN`. Do not infer the target event's state from elapsed time, a different event, an order snapshot, or historical advice. Never resend automatically.\\n\",\"contract_versions\":[2],\"digest\":\"5fb3732339600ad1332960df08a00299358b8c4ea47c20f6fedc39b568c9850e\",\"document_id\":\"receiver-ack-contract-v2\",\"expires_at\":\"2030-01-01T00:00:00+00:00\",\"file\":\"receiver-ack-contract-v2-1.md\",\"keywords\":[\"202\",\"receiver\",\"queue\",\"accepted\",\"processed\",\"processing_sla_seconds\",\"����\",\"�Ŷ�\",\"SLA\"],\"matched_terms\":[\"202\",\"acknowledgement\",\"http\",\"receiver\"],\"query\":\"HTTP 202 receiver acknowledgement\",\"retrieval_method\":\"bm25-lite-v1\",\"retrieval_score\":5.661359848075995,\"sour