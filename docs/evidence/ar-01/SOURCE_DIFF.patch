+def test_scope_revoke_after_observation_stops_history_then_fresh_reauthorization_works(setup):
+    async def check():
+        async with candidate_context(setup) as (candidate,client):
+            model=LocalModel()
+            first=await candidate.run(model,"当前订单状态？")
