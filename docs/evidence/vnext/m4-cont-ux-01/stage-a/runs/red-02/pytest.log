        import subprocess, sys
        db,identity,task=new_task(tmp_path,claim=False)
        tid,run=str(task["task_id"]),str(task["run_id"])
        cap=8
        if followup:
            claim_task_run(db,identity,run); finish_task_run(db,identity,run,"WAITING_INPUT")
