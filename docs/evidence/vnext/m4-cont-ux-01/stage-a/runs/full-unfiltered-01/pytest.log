0+00:00", "version": "2.1.0"}], "selected_skill_method_only": null, "skill_catalog": [{"description": "Use when order lifecycle is not yet established or HTTP 200 may be confused with completion; verify order first.", "name": "order-lifecycle-triage"}, {"description": "Use after a completed order: correlate delivery event, retry/failure details, acknowledgement and receiver queue; never resend.", "name": "callback-delivery-triage"}], "trusted_binding": {"contract_version": 2, "route": "/api/async-orders/async-order", "service_id": "orders-async-demo", "task_id": "task-51be85a4-7785-43f5-8992-536f41867887"}, "unexecuted_candidates": [], "untrusted_user_inputs": [{"accepted_control_revision": 0, "applied_control_revision": 0, "body": "订单 200 但回调尚未完成，请核对。", "digest": "26026039ab9fc8a5821f37fe9d659d742a27a60e97c3b9388b5c12eba39baa81", "input_kind": "CHAT_READONLY", "kind": "INITIAL_SYMPTOM", "message_id": "message-33afd9ad-120d-41bd-87f6-d54560980db9", "provenance": "USER_INPUT_UNTRUSTED", "sequence": 1}, {"accepted_control_revision": 0, "applied_control_revision": 0, "body": "同时核对回调受理、当前接收状态和当前协议含义，给出来源。", "digest": "8786febd078c71f8af2f7013b0776809d770600e27c60f3a0a472b86bc187623", "input_kind": "CHAT_READONLY", "kind": "READONLY_FOLLOWUP", "message_id": "message-e98481d6-5942-4ba4-992d-dde4457f72b2", "provenance": "USER_INPUT_UNTRUSTED", "sequence": 2}]}], "answer": {"answer_text": "本轮投递 HTTP 202 表示受理；同事件接收状态 QUEUED。协议来源 receiver-ack-contract-v2@2.1.0，当前状态来源 evidence-1b355263-944b-4750-a176-18442b3538f7。", "result_state": "ANSWERED", "result_json": "{\"attempt_budget\":{\"auxiliary\":{\"by_kind\":{\"CHAT\":0,\"CLASSIFIER\":1,\"COMPRESSION\":0},\"limit\":8,\"reason_code\":null,\"remaining\":7,\"used\":1},\"limit_reasons\":{\"MCP\":\"RUN_MCP_LIMIT\",\"MODEL\":\"RUN_MODEL_LIMIT\"},\"policy_version\":\"CONTUX_S3_V1\",\"remaining_attempts\":{\"MCP\":0,\"MODEL\":0},\"run_limits\":{\"MCP\":3,\"MODEL\":4},\"run_used\":{\"MCP\":3,\"MODEL\":4},\"task_limits\":{\"MCP\":18,\"MOD