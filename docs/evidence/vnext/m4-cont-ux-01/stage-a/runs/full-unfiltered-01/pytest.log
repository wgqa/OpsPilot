4b48-a9ee-5405701dd37c\\\",\\\"failure_code\\\":null,\\\"max_attempts\\\":3,\\\"order_id\\\":\\\"async-order\\\",\\\"processing_sla_seconds\\\":300,\\\"receiver_state\\\":\\\"QUEUED\\\",\\\"request_id\\\":\\\"transport-13313c8a-c615-4b57-afa0-9ced413e48b1\\\",\\\"retry_at\\\":null,\\\"retry_state\\\":\\\"NOT_APPLICABLE\\\"}\",\"version\":2},\"observed_at\":\"2026-10-26T05:22:45.085+00:00\",\"observed_versions\":{\"config_version\":1,\"contract_version\":2,\"delivery_version\":2,\"grant_version\":1,\"order_version\":2,\"policy_version\":1,\"principal_version\":1,\"receiver_version\":2,\"scope_policy_version\":1},\"original_result_ref\":\"s3://event-d05ffb4b-faf6-4b48-a9ee-5405701dd37c/v2\",\"principal_id\":\"async-principal-a\",\"resource_id\":\"orders-async-demo:async-order\",\"task_id\":\"task-84c8da79-c933-4293-ab03-1217e90abbc6\",\"tenant_id\":\"tenant-a\",\"trust_class\":\"untrusted_tool_observation\"}", "evidence_id": "evidence-7d7a57c4-d3b1-4423-977d-6e9884164e06", "created_at": "2026-10-26T05:22:45.089+00:00"}, {"observation_id": "observation-ec186e6c-99c2-4ba2-89de-42120e15b07b", "task_id": "task-84c8da79-c933-4293-ab03-1217e90abbc6", "call_id": "call-750d5415-6d22-4a42-91e7-22531fdb47f5", "attempt_id": "attempt-1bf06270-8c94-4966-966a-3cd3200bc3c7", "tool_call_id": "tool-6", "tool_name": "search_callback_knowledge", "argument_digest": "b925976f8bf9e2ce967453e53e4763557f524cc2b083b51d38d218b30899b5e9", "status": "OK", "progress_added": 1, "error_class": null, "result_digest": "3fde13db9394b11a81fa49316eef4a58d37ed3be284c13a09207fbd93622f265", "result_json": "{\"contract_version\":2,\"documents\":[{\"active\":true,\"applicable\":\"true\",\"bound_contract_version\":2,\"content\":\"# Receiver acknowledgement and processing SLA v2.1\\n\\nAn HTTP 202 from the receiver proves durable acceptance into its queue only. It does not by itself prove that the receiver completed business processing.\\n\\nCheck the receiver's current state for the same `event_id` and `delivery_version`. `PROCESSED` is sufficient to prove completion even before the SLA deadline, provided the current receiver observation is correlated to that same event and delivery version.\\n\\nSLA only sets the handling direction for a same-event receiver that remains `QUEUED`: before the trusted deadline, continue observing; at or after the deadline, contact the receiver operator to investigate. An overdue `QUEUED` state does not by itself prove business failure or event loss.\\n\\nHTTP 202 alone proves acceptance only; without current same-event receiver evidence, the processing state is `UNKNOWN`. Do not infer the target event's state from elapsed time, a different event, an order snapshot, or historical advice. Never resend automatically.\\n\",\"contract_versions\":[2],\"digest\":\"5fb3732339600ad1332960df08a00299358b8c4ea47c20f6fedc39b568c9850e\",\"document_id\":\"receiver-ack-contract-v2\",\"expires_at\":\"2030-01-01T00:00:00+00:00\",\"file\":\"receiver-ack-contract-v2-1.md\",\"keywords\":[\"202\",\"receiver\",\"queue\",\"accepted\",\"processed\",\"processing_sla_seconds\",\"接收\",\"排队\",\"SLA\"],\"matched_terms\":[\"202\",\"acknowledgement\",\"http\",\"receiver\"],\"query\":\"HTTP 202 receiver acknowledgement\",\"retrieval_method\":\"bm25-lite-v1\",\"retrieval_score\":5.661359848075995,\"source\":\"local:orders-async-demo/contract-v2.1\",\"title\":\"Receiver acknowledgement and processing SLA v2\",\"valid_from\":\"2026-10-25T00:00:00+00:00\",\"version\":\"2.1.0\"}],\"ranking_method\":\"bm25-lite-v1\",\"reason\":\"read an applicable source missing from this Run; deterministic test double\"}", "evidence_id": null, "created_at": "2026-10-26T05:22:45.238+00:00"}, {"observation_id": "observation-a5f1b1bd-fa3b-444a-ab9e-359e707a1a84", "task_id": "task-84c8da79-c933-4293-ab03-1217e90abbc6", "call_id": "call-5418e38e-631c-4e7d-84a7-427479e5a9e3", "attempt_id": "attempt-22be6555-9a42-4b23-8c82-ad8cc8af656c", "tool_call_id": "tool-9", "tool_name": "get_receiver_processin