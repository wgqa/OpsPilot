uery the matching active versioned asset if not already tried; otherwise report that source gap. Search with concise, discriminative terms for the missing clause (such as the status and receiving role); the bound contract version is selected automatically. If a result does not answer the goal, refine with new terms when budget allows; do not cite it as if it did. Do not repeat the same query without new information.", "attempt_budget": {"auxiliary": {"by_kind": {"CHAT": 0, "CLASSIFIER": 1, "COMPRESSION": 0}, "limit": 8, "reason_code": null, "remaining": 7, "used": 1}, "limit_reasons": {"MCP": null, "MODEL": null}, "policy_version": "CONTUX_S3_V1", "remaining_attempts": {"MCP": 1, "MODEL": 2}, "run_limits": {"MCP": 3, "MODEL": 4}, "run_used": {"MCP": 2, "MODEL": 2}, "task_limits": {"MCP": 18, "MODEL": 24}, "task_used": {"MCP": 2, "MODEL": 2}}, "candidate_decisions": [], "current_mcp_evidence": [{"facts": {"accepted_at": "2026-10-26T05:22:52.998241Z", "delivery_version": 2, "event_id": "event-c6d03534-d1f6-4203-9062-d8070fa4c095", "order_id": "async-order", "processing_sla_seconds": 300, "service_id": "orders-async-demo", "status": "QUEUED", "tenant_id": "tenant-a", "version": 2}, "id": "evidence-25c62891-ea9e-4d3f-ac02-d14bdf8df8d8", "observation": {"attempt_id": "attempt-74af7c92-f334-4b67-9fe9-baf725dbb2ec", "observation_id": "observation-f8380b62-51c3-4a31-84d5-3bd5c3291617", "observed_at": "2026-10-26T05:22:55.531000+00:00", "result_digest": "4ad45b5d28a4ef7eca85ca46901ca9514adc3c1e42712c2bb7b2cea039903868", "run_id": "run-c1-followup-93ca48ee-d0ed-4335-a1b4-41aee35370d5", "source_observed_at": "2026-10-26T05:22:55.526+00:00", "tool_name": "get_receiver_processing"}, "type": "s3_receiver", "versions": {"config_version": 1, "contract_version": 2, "delivery_version": 2, "grant_version": 1, "order_version": 2, "policy_version": 1, "principal_version": 1, "receiver_version": 2, "scope_policy_version": 1}}], "decision_feedback": "MCP_PROGRESS", "excluded_sources": [],