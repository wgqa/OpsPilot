served_at\":\"2026-10-26T05:51:03.615+00:00\",\"observed_versions\":{\"config_version\":1,\"contract_version\":2,\"delivery_version\":2,\"grant_version\":1,\"order_version\":2,\"policy_version\":1,\"principal_version\":1,\"receiver_version\":2,\"scope_policy_version\":1},\"original_result_ref\":\"s3://event-963baffd-5919-4aba-a606-af00121294c9/v2\",\"principal_id\":\"async-principal-a\",\"resource_id\":\"orders-async-demo:async-order\",\"task_id\":\"task-b864ff4c-bdc4-4577-9752-4a8cdabec7dc\",\"tenant_id\":\"tenant-a\",\"trust_class\":\"untrusted_tool_observation\"}", "evidence_id": "evidence-1938c9bb-3592-453e-a048-ba9e5c8537b5", "created_at": "2026-10-26T05:51:03.620+00:00"}, {"observation_id": "observation-2e0e5bcf-6fe4-4e57-bc28-a97394781adb", "task_id": "task-b864ff4c-bdc4-4577-9752-4a8cdabec7dc", "call_id": "call-168fad3f-3df3-4f62-b280-80757090c7d4", "attempt_id": "attempt-c25d6bf5-0079-4426-be33-0234ab30e24f", "tool_call_id": "tool-5", "tool_name": "search_callback_knowledge", "argument_digest": "b925976f8bf9e2ce967453e53e4763557f524cc2b083b51d38d218b30899b5e9", "status": "OK", "progress_added": 1, "error_class": null, "result_digest": "3fde13db9394b11a81fa49316eef4a58d37ed3be284c13a09207fbd93622f265", "result_json": "{\"contract_version\":2,\"documents\":[{\"active\":true,\"applicable\":\"true\",\"bound_contract_version\":2,\"content\":\"# Receiver acknowledgement and processing SLA v2.1\\n\\nAn HTTP 202 from the receiver proves durable acceptance into its queue only. It does not by itself prove that the receiver completed business processing.\\n\\nCheck the receiver's current state for the same `event_id` and `delivery_version`. `PROCESSED` is sufficient to prove completion even before the SLA deadline, provided the current receiver observation is correlated to that same event and delivery version.\\n\\nSLA only sets the handling direction for a same-event receiver that remains `QUEUED`: before the trusted deadline, continue observing; at or after the deadline, contact the receiver operator to investigate. An overdue `QUEUED` state does not by itself prove business failure or event loss.\\n\\nHTTP 202 alone proves acceptance only; without current same-event receiver evidence, the processing state is `UNKNOWN`. Do not infer the target event's state from elapsed time, a different event, an order snapshot, or historical advice. Never resend automatically.\\n\",\"contract_versions\":[2],\"digest\":\"5fb3732339600ad1332960df08a00299358b8c4ea47c20f6fedc39b568c9850e\",\"document_id\":\"receiver-ack-contract-v2\",\"expires_at\":\"2030-01-01T00:00:00+00:00\",\"file\":\"receiver-ack-contract-v2-1.md\",\"keywords\":[\"202\",\"receiver\",\"queue\",\"accepted\",\"processed\",\"processing_sla_seconds\",\"接收\",\"排队\",\"SLA\"],\"matched_terms\":[\"202\",\"acknowledgement\",\"http\",\"receiver\"],\"query\":\"HTTP 202 receiver acknowledgement\",\"retrieval_method\":\"bm25-lite-v1\",\"retrieval_score\":5.661359848075995,\"source\":\"local:orders-async-demo/contract-v2.1\",\"title\":\"Receiver acknowledgement and processing SLA v2\",\"valid_from\":\"2026-10-25T00:00:00+00:00\",\"version\":\"2.1.0\"}],\"ranking_method\":\"bm25-lite-v1\",\"reason\":\"read an applicable source missing from this Run; deterministic test double\"}", "evidence_id": null, "created_at": "2026-10-26T05:51:05.010+00:00"}, {"observation_id": "observation-a4daede8-eb08-4928-ac37-de02e96dee97", "task_id": "task-b864ff4c-bdc4-4577-9752-4a8cdabec7dc", "call_id": "call-f2963924-45f8-4ac3-b14f-3d53570e6f9d", "attempt_id": "attempt-cdf0f22d-8480-4355-b43a-7cb1a4642b9c", "tool_call_id": "tool-6", "tool_name": "get_callback_delivery", "argument_digest": "32a18bb796fc071a85e1c4c9323ba9bf3536e2c0d4388be8aecf6145ad93692d", "status": "OK", "progress_added": 0, "error_class": null, "result_digest": "c6c8f0a978c8e14523c4fa7a38dad8545d5709f4adec821714a929749a12f1e7", "result_json": "{\"data_source\":\"sqlite:s3_deliveries\",\"fact_type\":\"s3_delivery\",\"facts\":{\"attempt_count\