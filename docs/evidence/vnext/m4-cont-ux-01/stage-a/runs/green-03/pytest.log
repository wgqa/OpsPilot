served_at\":\"2026-10-25T18:48:18.830+00:00\",\"observed_versions\":{\"config_version\":1,\"contract_version\":2,\"delivery_version\":2,\"grant_version\":1,\"order_version\":2,\"policy_version\":1,\"principal_version\":1,\"receiver_version\":2,\"scope_policy_version\":1},\"original_result_ref\":\"s3://event-1ea181b1-1535-45e9-9b9f-27a579a1bc08/v2\",\"principal_id\":\"async-principal-a\",\"resource_id\":\"orders-async-demo:async-order\",\"task_id\":\"task-028448eb-53da-4fd8-ab7b-5d7ac50faf54\",\"tenant_id\":\"tenant-a\",\"trust_class\":\"untrusted_tool_observation\"}", "evidence_id": "evidence-7eb44a5e-3e27-4e87-83c6-9f2c462331ac", "created_at": "2026-10-25T18:48:18.834+00:00"}, {"observation_id": "observation-c9ebce11-f3d0-4e36-b209-f55638a153a6", "task_id": "task-028448eb-53da-4fd8-ab7b-5d7ac50faf54", "call_id": "call-03329ddf-da81-43b3-bcf2-e2efb267c8d0", "attempt_id": "attempt-8e18548d-17fa-40ed-89e2-2b375743aae5", "tool_call_id": "tool-5", "tool_name": "search_callback_knowledge", "argument_digest": "b925976f8bf9e2ce967453e53e4763557f524cc2b083b51d38d218b30899b5e9", "status": "OK", "progress_added": 1, "error_class": null, "result_digest": "3fde13db9394b11a81fa49316eef4a58d37ed3be284c13a09207fbd93622f265", "result_json": "{\"contract_version\":2,\"documents\":[{\"active\":true,\"applicable\":\"true\",\"bound_contract_version\":2,\"content\":\"# Receiver acknowledgement and processing SLA v2.1\\n\\nAn HTTP 202 from the receiver proves durable acceptance into its queue only. It does not by itself prove that the receiver completed business processing.\\n\\nCheck the receiver's current state for the same `event_id` and `delivery_version`. `PROCESSED` is sufficient to prove completion even before the SLA deadline, provided the current receiver observation is correlated to that same event and delivery version.\\n\\nSLA only sets the handling direction for a same-event receiver that remains `QUEUED`: before the trusted deadline, continue observing; at or after the deadline, contact the receiver operator to investigate. An overdue `QUEUED` state does not by itself prove business failure or event loss.\\n\\nHTTP 202 alone proves acceptance only; without current same-event receiver evidence, the processing state is `UNKNOWN`. Do not infer the target event's state from elapsed time, a different event, an order snapshot, or historical advice. Never resend automatically.\\n\",\"contract_versions\":[2],\"digest\":\"5fb3732339600ad1332960df08a00299358b8c4ea47c20f6fedc39b568c9850e\",\"document_id\":\"receiver-ack-contract-v2\",\"expires_at\":\"2030-01-01T00:00:00+00:00\",\"file\":\"receiver-ack-contract-v2-1.md\",\"keywords\":[\"202\",\"receiver\",\"queue\",\"accepted\",\"processed\",\"processing_sla_seconds\",\"接收\",\"排队\",\"SLA\"],\"matched_terms\":[\"202\",\"acknowledgement\",\"http\",\"receiver\"],\"query\":\"HTTP 202 receiver acknowledgement\",\"retrieval_method\":\"bm25-lite-v1\",\"retrieval_score\":5.661359848075995,\"source\":\"local:orders-async-demo/contract-v2.1\",\"title\":\"Receiver acknowledgement and processing SLA v2\",\"valid_from\":\"2026-10-25T00:00:00+00:00\",\"version\":\"2.1.0\"}],\"ranking_method\":\"bm25-lite-v1\",\"reason\":\"read an applicable source missing from this Run; deterministic test double\"}", "evidence_id": null, "created_at": "2026-10-25T18:48:20.285+00:00"}, {"observation_id": "observation-98f3019e-205c-4b2d-aeee-0ac18e47a262", "task_id": "task-028448eb-53da-4fd8-ab7b-5d7ac50faf54", "call_id": "call-efa37922-6559-45fd-82c3-dc82adb29067", "attempt_id": "attempt-63524870-f324-4d70-b835-7e30a6ba2109", "tool_call_id": "tool-6", "tool_name": "get_callback_delivery", "argument_digest": "32a18bb796fc071a85e1c4c9323ba9bf3536e2c0d4388be8aecf6145ad93692d", "status": "OK", "progress_added": 0, "error_class": null, "result_digest": "adf4109bf13a332fef088065d0decbefd7d1de98966b1104aa220b6937c81fa4", "result_json": "{\"data_source\":\"sqlite:s3_deliveries\",\"fact_type\":\"s3_delivery\",\"facts\":{\"attempt_count\