46d3-967a-ad491be64ba7\\\",\\\"failure_code\\\":null,\\\"max_attempts\\\":3,\\\"order_id\\\":\\\"async-order\\\",\\\"processing_sla_seconds\\\":300,\\\"receiver_state\\\":\\\"QUEUED\\\",\\\"request_id\\\":\\\"transport-be8343cc-5040-4057-8e0b-77c782f03254\\\",\\\"retry_at\\\":null,\\\"retry_state\\\":\\\"NOT_APPLICABLE\\\"}\",\"version\":2},\"observed_at\":\"2026-10-25T18:48:26.039+00:00\",\"observed_versions\":{\"config_version\":1,\"contract_version\":2,\"delivery_version\":2,\"grant_version\":1,\"order_version\":2,\"policy_version\":1,\"principal_version\":1,\"receiver_version\":2,\"scope_policy_version\":1},\"original_result_ref\":\"s3://event-0aa378c3-52c8-46d3-967a-ad491be64ba7/v2\",\"principal_id\":\"async-principal-a\",\"resource_id\":\"orders-async-demo:async-order\",\"task_id\":\"task-9de6518f-f6f6-494f-8b17-8c1056b6e304\",\"tenant_id\":\"tenant-a\",\"trust_class\":\"untrusted_tool_observation\"}", "evidence_id": "evidence-b77c943f-159d-4b5a-9237-4e0a990f034e", "created_at": "2026-10-25T18:48:26.045+00:00"}, {"observation_id": "observation-928f0d38-12a9-4c54-985d-bf71dfdc7b00", "task_id": "task-9de6518f-f6f6-494f-8b17-8c1056b6e304", "call_id": "call-b70c9c8a-c490-47f5-a935-58fbaf971611", "attempt_id": "attempt-e19dd81b-914a-47e2-9733-e815ed74acd5", "tool_call_id": "tool-6", "tool_name": "search_callback_knowledge", "argument_digest": "b925976f8bf9e2ce967453e53e4763557f524cc2b083b51d38d218b30899b5e9", "status": "OK", "progress_added": 1, "error_class": null, "result_digest": "3fde13db9394b11a81fa49316eef4a58d37ed3be284c13a09207fbd93622f265", "result_json": "{\"contract_version\":2,\"documents\":[{\"active\":true,\"applicable\":\"true\",\"bound_contract_version\":2,\"content\":\"# Receiver acknowledgement and processing SLA v2.1\\n\\nAn HTTP 202 from the receiver proves durable acceptance into its queue only. It does not by itself prove that the receiver completed business processing.\\n\\nCheck the receiver's current state for the same `event_id` and `delivery_version`. `PROCESSED` is sufficient to prove completion even before the SLA deadline, provided the current receiver observation is correlated to that same event and delivery version.\\n\\nSLA only sets the handling direction for a same-event receiver that remains `QUEUED`: before the trusted deadline, continue observing; at or after the deadline, contact the receiver operator to investigate. An overdue `QUEUED` state does not by itself prove business failure or event loss.\\n\\nHTTP 202 alone proves acceptance only; without current same-event receiver evidence, the processing state is `UNKNOWN`. Do not infer the target event's state from elapsed time, a different event, an order snapshot, or historical advice. Never resend automatically.\\n\",\"contract_versions\":[2],\"digest\":\"5fb3732339600ad1332960df08a00299358b8c4ea47c20f6fedc39b568c9850e\",\"document_id\":\"receiver-ack-contract-v2\",\"expires_at\":\"2030-01-01T00:00:00+00:00\",\"file\":\"receiver-ack-contract-v2-1.md\",\"keywords\":[\"202\",\"receiver\",\"queue\",\"accepted\",\"processed\",\"processing_sla_seconds\",\"接收\",\"排队\",\"SLA\"],\"matched_terms\":[\"202\",\"acknowledgement\",\"http\",\"receiver\"],\"query\":\"HTTP 202 receiver acknowledgement\",\"retrieval_method\":\"bm25-lite-v1\",\"retrieval_score\":5.661359848075995,\"source\":\"local:orders-async-demo/contract-v2.1\",\"title\":\"Receiver acknowledgement and processing SLA v2\",\"valid_from\":\"2026-10-25T00:00:00+00:00\",\"version\":\"2.1.0\"}],\"ranking_method\":\"bm25-lite-v1\",\"reason\":\"read an applicable source missing from this Run; deterministic test double\"}", "evidence_id": null, "created_at": "2026-10-25T18:48:26.198+00:00"}, {"observation_id": "observation-ca4c360c-42e7-4f55-b0e3-7e6a024034ab", "task_id": "task-9de6518f-f6f6-494f-8b17-8c1056b6e304", "call_id": "call-199a4f10-61e7-423a-aeb2-c87601e85c46", "attempt_id": "attempt-dace15dd-595e-46c9-b3d6-e90044985bfc", "tool_call_id": "tool-9", "tool_name": "get_receiver_processin