      },
      {
        "application_state": "RECEIVED_NOT_APPLIED",
        "applied_run_id": null,
        "body": "为什么这个 Task 当前仍判定为鉴权失败？请解释现有证据。",
        "body_digest": "e23b07972ca19640a0e34b76c290070157d48d313c0f007700ea962c2b4cc2b5",
        "created_at": "2026-10-22T17:18:40.496+00:00",
