      "tools_json": "[{\"function\":{\"description\":\"Read the bound order through real authenticated HTTP; 200 alone does not prove completion.\",\"name\":\"get_order_status\",\"parameters\":{\"properties\":{\"reason\":{\"description\":\"A brief reason for this next query, at most 160 characters recommended.\",\"maxLength\":400,\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"}},\"required\":[\"reason\"],\"title\":\"get_order_statusArguments\",\"type\":\"object\"}},\"type\":\"function\"},{\"function\":{\"description\":\"Read current bound callback event, order version and actual transport acknowledgement/failure.\",\"name\":\"get_callback_delivery\",\"parameters\":{\"properties\":{\"reason\":{\"description\":\"A brief reason for this next query, at most 160 characters recommended.\",\"maxLength\":400,\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"}},\"required\":[\"reason\"],\"title\":\"get_callback_deliveryArguments\",\"type\":\"object\"}},\"type\":\"function\"},{\"function\":{\"description\":\"Read current processing state for the bound callback event. ACK is not completed processing.\",\"name\":\"get_receiver_processing\",\"parameters\":{\"properties\":{\"reason\":{\"description\":\"A brief reason for this next query, at most 160 characters recommended.\",\"maxLength\":400,\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"}},\"required\":[\"reason\"],\"title\":\"get_receiver_processingArguments\",\"type\":\"object\"}},\"type\":\"function\"},{\"function\":{\"description\":\"Retrieve one relevant active versioned integration contract by a short query; method only, not live facts.\",\"name\":\"search_callback_knowledge\",\"parameters\":{\"properties\":{\"query\":{\"maxLength\":300,\"minLength\":1,\"title\":\"Query\",\"type\":\"string\"},\"reason\":{\"description\":\"A brief reason for this next query, at most 160 characters recommended.\",\"maxLength\":400,\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"}},\"required\":[\"query\",\"reason\"],\"title\":\"search_callback_knowledgeArguments\",\"type\":\"object\"}},\"type\":\"function\"},{\"function\":{\"description\":\"Load one method when useful: order-lifecycle-triage or callback-delivery-triage. Does not change authority.\",\"name\":\"load_callback_skill\",\"parameters\":{\"properties\":{\"name\":{\"enum\":[\"order-lifecycle-triage\",\"callback-delivery-triage\"],\"title\":\"Name\",\"type\":\"string\"},\"reason\":{\"description\":\"A brief reason for this next query, at most 160 characters recommended.\",\"maxLength\":400,\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"}},\"required\":[\"name\",\"reason\"],\"title\":\"load_callback_skillArguments\",\"type\":\"object\"}},\"type\":\"function\"}]"
