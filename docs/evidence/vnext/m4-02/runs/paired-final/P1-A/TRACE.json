ason\"],\"title\":\"search_callback_knowledgeArguments\",\"type\":\"object\"}},\"type\":\"function\"},{\"function\":{\"description\":\"Load one method when useful: order-lifecycle-triage or callback-delivery-triage. Does not change authority.\",\"name\":\"load_callback_skill\",\"parameters\":{\"properties\":{\"name\":{\"enum\":[\"order-lifecycle-triage\",\"callback-delivery-triage\"],\"title\":\"Name\",\"type\":\"string\"},\"reason\":{\"description\":\"A brief reason for this next query, at most 160 characters recommended.\",\"maxLength\":400,\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"}},\"required\":[\"name\",\"reason\"],\"title\":\"load_callback_skillArguments\",\"type\":\"object\"}},\"type\":\"function\"}]"
