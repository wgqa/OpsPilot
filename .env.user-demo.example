# Copy to .env and replace the two required local demo passwords.
# This demo config intentionally keeps every Provider path disabled.
OPSPILOT_DB_PATH=.runtime/user-demo/domain.sqlite3
OPSPILOT_CHECKPOINT_DB_PATH=.runtime/user-demo/checkpoint.sqlite3
OPSPILOT_WEB_ORIGIN=http://127.0.0.1:8000
OPSPILOT_WEB_SUPPORT_PASSWORD=CHANGE_ME_LOCAL_SUPPORT_PASSWORD
OPSPILOT_WEB_APPROVER_PASSWORD=CHANGE_ME_LOCAL_APPROVER_PASSWORD
# Optional second-tenant logins for isolation demonstrations.
OPSPILOT_WEB_SUPPORT_B_PASSWORD=
OPSPILOT_WEB_APPROVER_B_PASSWORD=
OPSPILOT_DEMO_SERVICE_ID=orders-demo
OPSPILOT_DEMO_INTEGRATION_ID=integration-a
OPSPILOT_DEMO_TICKET_ID=INC-A-001
OPSPILOT_ASSISTANT_RUNTIME_ENABLED=0
OPSPILOT_ASSISTANT_PROVIDER_ENABLED=0
OPSPILOT_LEGACY_PROVIDER_ENABLED=0
OPSPILOT_ASSISTANT_EXPERIMENT_ID=
# Live-mode values below are optional in Offline mode and are not enabled by
# this template. Configure only after a separate explicit paid-use decision.
OPSPILOT_MODEL_API_KEY=
OPSPILOT_MODEL_NAME=deepseek-flash
OPSPILOT_MODEL_BASE_URL=https://api.deepseek.com
OPSPILOT_MODEL_CONFIG_VERSION=
OPSPILOT_MODEL_PRICE_VERSION=
OPSPILOT_MODEL_INPUT_RATE_MICRO_PER_MILLION=
OPSPILOT_MODEL_OUTPUT_RATE_MICRO_PER_MILLION=
OPSPILOT_ASSISTANT_SERVICE_IDENTITY=opspilot-user-demo-local
